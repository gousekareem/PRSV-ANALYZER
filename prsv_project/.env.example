APP_NAME=PRSV Research Diagnostic System
APP_VERSION=2.9.0

# NEVER set this to true outside your own local dev machine - it makes
# FastAPI/Starlette return full stack traces to any caller.
DEBUG=false

# Portable by default (repo_root/Original Images). Only set this if your
# dataset lives somewhere else, e.g.:
# DEMO_DATASET_PATH=C:\Users\you\Pictures\PRSV Dataset
# DEMO_DATASET_PATH=/home/you/datasets/prsv

MAX_UPLOAD_SIZE_MB=25
MAX_ZIP_SIZE_MB=200
IMAGE_WIDTH=128
IMAGE_HEIGHT=128

RAG_TOP_K=3

ENABLE_DENOISING=true
ENABLE_CLAHE=true
ENABLE_DEBUG_VISUALS=true

# How many days a run folder under data/outputs/ is kept before it's
# automatically cleaned up (runs once every 24h in the background - see
# scripts/cleanup_outputs.py for the manual/cron equivalent). 0 disables
# age-based cleanup.
OUTPUT_RETENTION_DAYS=30

# Optional API key gate for /api/* routes. Leave blank (default) for local/
# research use. Set a value to require callers to send it back as the
# X-API-Key header - do this before deploying beyond your own machine.
API_KEY=

# Simple in-memory rate limit applied to /api/* routes, per client IP.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
