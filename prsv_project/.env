APP_NAME=PRSV Research Diagnostic System
APP_VERSION=3.1.0

# NEVER set this to true outside your own local dev machine - it makes
# FastAPI/Starlette return full stack traces to any caller.
DEBUG=false

# Portable by default (repo_root/Original Images). Only set this if your
# dataset lives somewhere else, e.g.:
# DEMO_DATASET_PATH=C:\Users\you\Pictures\PRSV Dataset
# DEMO_DATASET_PATH=/home/you/datasets/prsv

MAX_UPLOAD_SIZE_MB=25
MAX_ZIP_SIZE_MB=200
IMAGE_WIDTH=128
IMAGE_HEIGHT=128

RAG_TOP_K=3

ENABLE_DENOISING=true
ENABLE_CLAHE=true
ENABLE_DEBUG_VISUALS=true

# How many days a run folder under data/outputs/ is kept before it's
# automatically cleaned up (runs once every 24h in the background - see
# scripts/cleanup_outputs.py for the manual/cron equivalent). 0 disables
# age-based cleanup.
OUTPUT_RETENTION_DAYS=30

# Optional API key gate for /api/* routes. Leave blank (default) for local/
# research use. Set a value to require callers to send it back as the
# X-API-Key header - do this before deploying beyond your own machine.
API_KEY=

# Simple in-memory rate limit applied to /api/* routes, per client IP.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# v3.0 additions - all optional. The app runs identically to v2.9 with every
# one of these left at its default/blank value; each feature self-degrades
# gracefully if its optional package or credential isn't provided.
# ---------------------------------------------------------------------------

# RAG upgrade path (see rag/hybrid_retriever.py, rag/llm_generator.py).
# Leave both true to get the best retrieval/generation quality actually
# available on this machine; set to false to force v2.9 TF-IDF + template
# behavior even if the optional packages are installed (useful for A/B
# comparisons via rag/rag_eval.py).
RAG_USE_HYBRID_RETRIEVAL=true
RAG_USE_LLM_GENERATION=true
RAG_CANDIDATE_POOL_SIZE=15

# Set this to enable real grounded LLM generation in the RAG pipeline
# (rag/llm_generator.py). Blank = template-based generation only (v2.9
# behavior), which always works with zero external dependencies.
ANTHROPIC_API_KEY=

# Optional Redis cache for repeated chatbot/RAG queries
# (app/services/cache_service.py). Blank = in-process dict cache (works fine
# for a single-process deployment, just isn't shared across workers).
# Example: REDIS_URL=redis://localhost:6379/0
REDIS_URL=
CACHE_TTL_SECONDS=3600

# Optional MLflow experiment tracking for ml/train_svm.py and
# ml/train_ensemble.py (mlops/experiment_tracking.py). Blank = mlflow logs
# to a local ./mlruns directory if the package is installed, or is skipped
# entirely as a no-op if it isn't.
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_NAME=prsv-analyzer

